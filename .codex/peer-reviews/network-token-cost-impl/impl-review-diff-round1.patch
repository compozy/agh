+    await waitFor(() => expect(promoteNetworkThreadTaskMock).toHaveBeenCalledTimes(1));
+    expect(promoteNetworkThreadTaskMock.mock.calls[0]).toMatchObject([
+      "ws_1",
+      "ops",
+      "thread_ops",
+      { origin_message_id: "msg_root", title: "Launch follow-up" },
