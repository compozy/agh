+func (r *Router) selectActivatedThreadPeers(
+	peers []LocalPeer,
+	envelope Envelope,
+	participants map[string]bool,
+	mentioned map[string]bool,
+) []LocalPeer {
+	if len(peers) == 0 {
+		return nil
+	}
+	selected := make([]LocalPeer, 0, min(len(peers), r.activationTopK+len(mentioned)))
+	seen := make(map[string]bool, len(peers))
+	for _, peer := range peers {
+		peerID := strings.TrimSpace(peer.PeerID)
+		if peerID == "" || isEnvelopeSender(peer, envelope) {
+			continue
+		}
+		if mentioned[peerID] || participants[peerID] {
+			selected = append(selected, peer)
+			seen[peerID] = true
+		}
+	}
+	candidates := rankActivationCandidates(peers, envelope)
+	limit := r.activationTopK
+	for _, candidate := range candidates {
+		if len(selected) >= limit+len(mentioned) {
+			break
+		}
+		peerID := strings.TrimSpace(candidate.peer.PeerID)
+		if seen[peerID] || isEnvelopeSender(candidate.peer, envelope) {
+			continue
+		}
+		selected = append(selected, candidate.peer)
+		seen[peerID] = true
+	}
