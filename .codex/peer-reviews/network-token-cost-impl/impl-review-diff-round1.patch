+    });
+
+    renderWithClient(
+      <ThreadOverlayHeader
+        channel="ops"
+        detail={detail}
+        rootMessageId="msg_root"
+        selfPeerId="peer-self"
+        threadId="thread_ops"
+        workspaceId="ws_1"
+      />
+    );
+
+    await user.click(screen.getByTestId("network-thread-promote-task"));
