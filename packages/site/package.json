{
    "name": "@agh/site",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "generate:openapi": "bun run scripts/generate-openapi.ts",
        "source:generate": "bun --bun fumadocs-mdx source.config.ts .source",
        "content:generate": "bun --bun velite build",
        "generate:content": "bun run source:generate && bun run content:generate",
        "generate": "bun run generate:openapi && bun run generate:content",
        "predev": "bun run generate",
        "prebuild": "bun run generate",
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "test": "vitest run",
        "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit"
    },
    "dependencies": {
        "@agh/ui": "workspace:*",
        "@mdx-js/mdx": "^3.1.1",
        "@remotion/player": "^4.0.490",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "fumadocs-core": "^16.11.5",
        "fumadocs-mdx": "^15.2.0",
        "fumadocs-openapi": "^11.2.2",
        "fumadocs-ui": "^16.11.5",
        "lucide-react": "^1.25.0",
        "mermaid": "^11.16.0",
        "next": "^16.2.10",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "rehype-pretty-code": "^0.14.4",
        "remark": "^15.0.1",
        "remark-gfm": "^4.0.1",
        "remark-mdx": "^3.1.1",
        "remotion": "^4.0.490",
        "shiki": "^4.3.1",
        "velite": "^0.4.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.3",
        "jsdom": "^29.1.1",
        "tailwindcss": "^4.3.3",
        "vitest": "^4.1.10"
    }
}
