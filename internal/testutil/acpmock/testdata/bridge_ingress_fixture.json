{
    "version": 2,
    "agents": [
        {
            "name": "bridge-runner",
            "provider": "claude",
            "permissions": "approve-all",
            "prompt": "You answer runtime bridge ingress prompts in daemon E2E tests.",
            "turns": [
                {
                    "name": "initial-bridge-summary",
                    "match": {
                        "turn_source": "network",
                        "occurrence": 1,
                        "user_text": "Need a runtime bridge summary",
                        "network": {
                            "message_id": "321",
                            "kind": "message",
                            "from": "777"
                        }
                    },
                    "steps": [
                        {
                            "kind": "tool_call",
                            "tool_call_id": "bridge-runtime-terminal-1",
                            "title": "agh__terminal",
                            "tool_kind": "read",
                            "raw_input": {
                                "command": "echo sk-e2e-progress-secret"
                            },
                            "status": "completed",
                            "content_text": "terminal command completed"
                        },
                        {
                            "kind": "assistant",
                            "chunks": ["Bridge summary: ", "initial route handled."]
                        }
                    ]
                },
                {
                    "name": "follow-up-bridge-summary",
                    "match": {
                        "turn_source": "network",
                        "occurrence": 2,
                        "user_text": "Provide a follow-up runtime bridge summary",
                        "network": {
                            "message_id": "322",
                            "kind": "message",
                            "from": "777"
                        }
                    },
                    "steps": [
                        {
                            "kind": "assistant",
                            "chunks": ["Bridge summary: ", "follow-up reused the existing session."]
                        }
                    ]
                }
            ]
        }
    ]
}
