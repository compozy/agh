{
    "version": 2,
    "agents": [
        {
            "name": "goal_rejections",
            "provider": "claude",
            "model": "goal-e2e-judge",
            "permissions": "approve-all",
            "prompt": "You are a deterministic Goal lifecycle worker and judge.",
            "config_options": [
                {
                    "id": "model",
                    "name": "Model",
                    "current": "goal-e2e-judge",
                    "values": [{ "value": "goal-e2e-judge", "label": "Goal E2E judge" }]
                }
            ],
            "turns": [
                {
                    "name": "goal-rejections-work-1",
                    "match": { "turn_source": "synthetic", "occurrence": 1 },
                    "steps": [
                        { "kind": "assistant", "text": "```json\n{\"status\":\"complete\"}\n```" }
                    ]
                },
                {
                    "name": "goal-rejections-work-2",
                    "match": { "turn_source": "synthetic", "occurrence": 2 },
                    "steps": [
                        { "kind": "assistant", "text": "```json\n{\"status\":\"complete\"}\n```" }
                    ]
                },
                {
                    "name": "goal-rejections-work-3",
                    "match": { "turn_source": "synthetic", "occurrence": 3 },
                    "steps": [
                        { "kind": "assistant", "text": "```json\n{\"status\":\"complete\"}\n```" }
                    ]
                },
                {
                    "name": "goal-rejections-judge",
                    "match": { "turn_source": "user" },
                    "steps": [
                        {
                            "kind": "sandbox_exec",
                            "tool_call_id": "goal-rejections-judge-command",
                            "title": "Evaluate deterministic Goal attempt",
                            "command": "sh",
                            "args": ["goal-judge.sh", "rejections"],
                            "emit_output": true
                        }
                    ]
                }
            ]
        },
        {
            "name": "goal_pause",
            "provider": "claude",
            "model": "goal-e2e-judge",
            "permissions": "approve-all",
            "prompt": "You are a deterministic pause and resume Goal worker.",
            "config_options": [
                {
                    "id": "model",
                    "name": "Model",
                    "current": "goal-e2e-judge",
                    "values": [{ "value": "goal-e2e-judge", "label": "Goal E2E judge" }]
                }
            ],
            "turns": [
                {
                    "name": "goal-pause-work-1",
                    "match": { "turn_source": "synthetic", "occurrence": 1 },
                    "steps": [
                        {
                            "kind": "sandbox_exec",
                            "tool_call_id": "goal-pause-delay",
                            "title": "Hold the first Goal boundary",
                            "command": "sh",
                            "args": ["-c", "sleep 1; printf '%s' '{\"status\":\"complete\"}'"],
                            "emit_output": true
                        }
                    ]
                },
                {
                    "name": "goal-pause-work-2",
                    "match": { "turn_source": "synthetic", "occurrence": 2 },
                    "steps": [
                        { "kind": "assistant", "text": "```json\n{\"status\":\"complete\"}\n```" }
                    ]
                },
                {
                    "name": "goal-pause-judge",
                    "match": { "turn_source": "user" },
                    "steps": [
                        {
                            "kind": "sandbox_exec",
                            "tool_call_id": "goal-pause-judge-command",
                            "title": "Approve the resumed Goal",
                            "command": "sh",
                            "args": ["goal-judge.sh", "pass"],
                            "emit_output": true
                        }
                    ]
                }
            ]
        },
        {
            "name": "goal_approval",
            "provider": "claude",
            "model": "goal-e2e-judge",
            "permissions": "approve-all",
            "prompt": "You are a deterministic Goal approval-grant worker.",
            "config_options": [
                {
                    "id": "model",
                    "name": "Model",
                    "current": "goal-e2e-judge",
                    "values": [{ "value": "goal-e2e-judge", "label": "Goal E2E judge" }]
                }
            ],
            "turns": [
                {
                    "name": "goal-approval-refusal",
                    "match": { "turn_source": "synthetic", "occurrence": 1 },
                    "steps": [
                        { "kind": "assistant", "text": "```json\n{\"status\":\"complete\"}\n```" }
                    ],
                    "stop_reason": "refusal"
                },
                {
                    "name": "goal-approval-reentry",
                    "match": { "turn_source": "synthetic", "occurrence": 2 },
                    "steps": [
                        { "kind": "assistant", "text": "```json\n{\"status\":\"complete\"}\n```" }
                    ]
                },
                {
                    "name": "goal-approval-judge",
                    "match": { "turn_source": "user" },
                    "steps": [
                        {
                            "kind": "sandbox_exec",
                            "tool_call_id": "goal-approval-judge-command",
                            "title": "Approve the granted Goal",
                            "command": "sh",
                            "args": ["goal-judge.sh", "pass"],
                            "emit_output": true
                        }
                    ]
                }
            ]
        },
        {
            "name": "goal_clear",
            "provider": "claude",
            "model": "goal-e2e-judge",
            "permissions": "approve-all",
            "prompt": "You are a deterministic active-prompt clear-fence worker.",
            "config_options": [
                {
                    "id": "model",
                    "name": "Model",
                    "current": "goal-e2e-judge",
                    "values": [{ "value": "goal-e2e-judge", "label": "Goal E2E judge" }]
                }
            ],
            "turns": [
                {
                    "name": "goal-clear-blocked-work",
                    "match": { "turn_source": "synthetic", "occurrence": 1 },
                    "steps": [
                        { "kind": "assistant", "text": "Goal clear prompt started." },
                        {
                            "kind": "driver_control",
                            "driver_control": { "action": "block_until_cancel" }
                        }
                    ]
                },
                {
                    "name": "goal-clear-judge",
                    "match": { "turn_source": "user" },
                    "steps": [
                        {
                            "kind": "sandbox_exec",
                            "tool_call_id": "goal-clear-judge-command",
                            "title": "Approve an uncleared Goal",
                            "command": "sh",
                            "args": ["goal-judge.sh", "pass"],
                            "emit_output": true
                        }
                    ]
                }
            ]
        }
    ]
}
